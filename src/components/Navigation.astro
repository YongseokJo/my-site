---
import DarkModeToggle from "../islands/DarkModeToggle.tsx";
import SearchToggle from "../islands/SearchToggle.tsx";

const currentPath = Astro.url.pathname;

const navLinks = [
  { name: "Home", href: "/", highlight: false },
  { name: "Research", href: "/research", highlight: false },
  { name: "Publications", href: "/publications", highlight: false },
  { name: "About", href: "/about", highlight: false },
  { name: "Contact", href: "/contact", highlight: false },
  { name: "Enzo-Abyss", href: "/software", highlight: true },
  { name: "Readea", href: "/arxiv-app", highlight: true },
];

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<nav class="bg-background/95 border-b border-border sticky top-0 z-50 backdrop-blur-md">
  <div class="max-w-6xl mx-auto px-5 md:px-8 flex items-center justify-between h-[72px]">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-3 text-foreground no-underline hover:text-primary">
      <span class="flex h-9 w-9 items-center justify-center rounded-full border border-primary/50 text-sm font-bold tracking-tight text-primary" aria-hidden="true">YJ</span>
      <span class="text-base font-semibold tracking-tight">Yongseok Jo</span>
    </a>

    <!-- Desktop nav links -->
    <div class="hidden lg:flex items-center gap-0.5">
      {navLinks.filter(l => !l.highlight).map((link) => (
        <a
          href={link.href}
          class:list={[
            "px-2.5 py-2 text-sm font-medium transition-colors duration-150 min-h-[48px] flex items-center border-b-2",
            isActive(link.href)
              ? "text-foreground border-primary"
              : "border-transparent text-muted-foreground hover:text-foreground hover:border-primary/40",
          ]}
        >
          {link.name}
        </a>
      ))}
      <div class="w-px h-6 bg-border mx-3"></div>
      <div class="flex items-center gap-1">
        {navLinks.filter(l => l.highlight).map((link) => (
          <a
            href={link.href}
            class:list={[
              "px-2.5 py-2 text-sm font-semibold transition-colors duration-150 rounded-md min-h-[48px] flex items-center border",
              isActive(link.href)
                ? "bg-primary text-primary-foreground border-primary"
                : "border-primary text-primary hover:bg-primary hover:text-primary-foreground",
            ]}
          >
            {link.name}
          </a>
        ))}
      </div>
      <div class="w-px h-6 bg-border mx-2"></div>
      <div>
        <SearchToggle client:load />
      </div>
      <div>
        <DarkModeToggle client:load />
      </div>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="lg:hidden flex items-center justify-center h-12 w-12 text-foreground"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        <path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-border bg-background">
    <div class="px-4 py-4 space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "block px-3 py-3 text-sm font-medium transition-all duration-150 rounded-md min-h-[48px] flex items-center border",
            link.highlight
              ? isActive(link.href)
                ? "bg-primary text-primary-foreground border-primary"
                : "border-primary text-primary hover:bg-primary hover:text-primary-foreground"
              : isActive(link.href)
                ? "bg-muted text-foreground border-transparent"
                : "border-transparent text-muted-foreground hover:text-foreground hover:bg-muted",
          ]}
        >
          {link.name}
        </a>
      ))}
      <div class="px-3 py-2">
        <SearchToggle client:load />
      </div>
      <div class="px-3 py-2">
        <DarkModeToggle client:load />
      </div>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const hamburgerIcon = document.getElementById("hamburger-icon");
  const closeIcon = document.getElementById("close-icon");

  btn?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(isOpen));
    hamburgerIcon?.classList.toggle("hidden", isOpen);
    closeIcon?.classList.toggle("hidden", !isOpen);
  });
</script>
