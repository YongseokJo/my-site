<section class="w-full bg-[#0a0e1a] relative">
  <div
    class="absolute inset-0"
    style="background: linear-gradient(to bottom, rgba(10, 14, 26, 0.7), rgba(10, 14, 26, 0.95));"
  ></div>
  <div class="relative max-w-[1100px] mx-auto px-4 md:px-6 lg:px-8 py-20 md:py-24 text-center">
    <h1 class="text-4xl font-bold text-[#e2e8f0]">Readea</h1>
    <p class="text-base text-[#94a3b8] mt-4 mb-8">
      A modern reading experience for arXiv papers on macOS and iOS
    </p>
    <div class="mb-8 grid grid-cols-1 md:grid-cols-2 gap-6 relative">
      <button type="button" class="relative cursor-zoom-in readea-zoomable rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary" aria-label="Enlarge Readea feed screenshot">
        <img src="/images/readea1.png" alt="" class="rounded-xl shadow-2xl w-full h-auto readea-img-a" />
        <img src="/images/readea1_1.png" alt="" class="rounded-xl shadow-2xl w-full h-auto readea-img-b absolute inset-0 opacity-0" />
      </button>
      <button type="button" class="relative cursor-zoom-in readea-zoomable rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary" aria-label="Enlarge Readea library screenshot">
        <img src="/images/readea2.png" alt="" class="rounded-xl shadow-2xl w-full h-auto readea-img-a" />
        <img src="/images/readea2_1.png" alt="" class="rounded-xl shadow-2xl w-full h-auto readea-img-b absolute inset-0 opacity-0" />
      </button>
    </div>

    <!-- Zoom overlay -->
    <div id="zoom-overlay" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/85 p-4" role="dialog" aria-modal="true" aria-label="Readea screenshot preview">
      <button id="zoom-close" type="button" class="absolute right-4 top-4 rounded-lg bg-white px-3 py-2 font-medium text-slate-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Close preview</button>
      <img id="zoom-img" src="" alt="" class="max-w-[90vw] max-h-[90vh] rounded-xl shadow-2xl" />
    </div>
    <a
      href="/arxiv-app/beta"
      class="inline-flex items-center justify-center px-6 py-3 bg-primary text-primary-foreground font-medium rounded-lg hover:opacity-90 transition-opacity"
    >
      Join the Beta
    </a>
  </div>
</section>

<style>
  .readea-img-a, .readea-img-b {
    transition: opacity 1s ease-in-out;
  }
</style>

<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    setInterval(() => {
      document.querySelectorAll('.readea-img-a, .readea-img-b').forEach(el => {
        el.classList.toggle('opacity-0');
      });
    }, 4000);
  }

  // Zoom on click
  const overlay = document.getElementById('zoom-overlay');
  const zoomImg = document.getElementById('zoom-img') as HTMLImageElement;
  const closeButton = document.getElementById('zoom-close') as HTMLButtonElement;
  let lastTrigger: HTMLButtonElement | null = null;

  function closePreview() {
    overlay?.classList.add('hidden');
    overlay?.classList.remove('flex');
    zoomImg.src = '';
    lastTrigger?.focus();
  }

  document.querySelectorAll('.readea-zoomable').forEach(container => {
    container.addEventListener('click', () => {
      // Find the visible image (the one without opacity-0)
      const imgs = container.querySelectorAll('img');
      let visibleSrc = '';
      imgs.forEach(img => {
        if (!img.classList.contains('opacity-0')) {
          visibleSrc = img.src;
        }
      });
      if (visibleSrc && overlay && zoomImg) {
        zoomImg.src = visibleSrc;
        zoomImg.alt = container.getAttribute('aria-label')?.replace('Enlarge ', '') ?? 'Readea screenshot';
        lastTrigger = container as HTMLButtonElement;
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
        closeButton.focus();
      }
    });
  });

  closeButton?.addEventListener('click', closePreview);
  overlay?.addEventListener('click', (event) => {
    if (event.target === overlay) closePreview();
  });

  document.addEventListener('keydown', (e) => {
    if (!overlay?.classList.contains('flex')) return;
    if (e.key === 'Escape') closePreview();
    if (e.key === 'Tab') {
      e.preventDefault();
      closeButton.focus();
    }
  });
</script>
