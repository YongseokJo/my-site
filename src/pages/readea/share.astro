---
export const prerender = true;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Shared papers · READEA</title>
    <meta name="description" content="Open shared research papers in READEA." />
    <style>
      :root { color-scheme: light; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #f6f3f1; color: #25232a; }
      main { width: min(100% - 36px, 560px); margin: 48px auto; background: white; border: 1px solid #e8e2df; border-radius: 22px; box-shadow: 0 16px 52px #35142612; padding: clamp(24px, 5vw, 40px); }
      .eyebrow { color: #6f233c; font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
      h1 { font-size: clamp(26px, 5vw, 34px); letter-spacing: -.03em; margin: 12px 0 8px; }
      p { color: #66616a; line-height: 1.5; }
      ol { padding-left: 24px; margin: 26px 0; }
      li { padding: 9px 0; line-height: 1.4; overflow-wrap: anywhere; }
      .actions { margin-top: 28px; }
      .button { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 18px; border-radius: 10px; background: #6f233c; color: white; font-weight: 600; text-decoration: none; }
      .button:hover { background: #52182d; }
      .note { font-size: 13px; margin-top: 14px; }
    </style>
  </head>
  <body>
    <main>
      <div class="eyebrow">READEA</div>
      <h1>Shared papers</h1>
      <p id="intro">Checking this share link…</p>
      <ol id="papers" hidden></ol>
      <div class="actions"><a id="open" class="button" hidden>Open in READEA</a></div>
      <p id="note" class="note" hidden>If the app does not open automatically, use the button above on a device with READEA installed.</p>
    </main>
    <script is:inline>
      const id = new URLSearchParams(location.search).get('id');
      const intro = document.getElementById('intro');
      const list = document.getElementById('papers');
      const open = document.getElementById('open');
      const note = document.getElementById('note');
      async function showShare() {
        try {
          if (!id || !/^[A-Za-z0-9_-]{20,80}$/.test(id)) throw new Error('invalid');
          const response = await fetch(`/readea/share/bundle?id=${encodeURIComponent(id)}`);
          if (!response.ok) throw new Error('missing');
          const bundle = await response.json();
          if (bundle.version !== 1 || !Array.isArray(bundle.papers) || bundle.papers.length < 1 || bundle.papers.length > 40) throw new Error('invalid');
          for (const paper of bundle.papers) {
            if (typeof paper.title !== 'string' || !paper.title.trim() || typeof paper.url !== 'string') throw new Error('invalid');
            const source = new URL(paper.url);
            if (!['https:', 'http:'].includes(source.protocol)) throw new Error('invalid');
            const item = document.createElement('li');
            const link = document.createElement('a');
            link.href = source.href;
            link.textContent = paper.title;
            link.rel = 'noopener noreferrer';
            item.append(link);
            list.append(item);
          }
          intro.textContent = bundle.papers.length === 1 ? 'One paper is ready to import into READEA.' : `${bundle.papers.length} papers are ready to import into READEA.`;
          list.hidden = false;
          open.href = `readea://share?id=${encodeURIComponent(id)}`;
          open.hidden = false;
          note.hidden = false;
        } catch {
          intro.textContent = 'This share link is incomplete or unavailable. Ask the sender to share the papers again.';
        }
      }
      showShare();
    </script>
  </body>
</html>
